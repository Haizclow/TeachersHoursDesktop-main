<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<TabPane xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.example.teacherhoursdesktop.controllers.MainController"
         tabClosingPolicy="UNAVAILABLE">

    <Tab text="Преподаватели">
        <VBox spacing="10" style="-fx-padding: 15;">
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Добавить преподавателя" fx:id="addTeacherButton" onAction="#handleAddTeacher"/>
            </HBox>
            <TableView fx:id="teachersTable">
                <columns>
                    <TableColumn text="ФИО" fx:id="fullNameColumn" prefWidth="200"/>
                    <TableColumn text="Кафедра" fx:id="departmentColumn" prefWidth="150"/>
                    <TableColumn text="Плановые часы" fx:id="plannedHoursColumn" prefWidth="100"/>
                    <TableColumn text="Отработано" fx:id="completedHoursColumn" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </Tab>

    <Tab text="Расписание">
        <VBox spacing="10" style="-fx-padding: 15;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Преподаватель:"/>
                <ComboBox fx:id="teacherCombo" prefWidth="300"/>
                <Label text="Период:"/>
                <ComboBox fx:id="periodCombo" prefWidth="100"/>
            </HBox>
            <TableView fx:id="scheduleTable">
                <columns>
                    <TableColumn text="Дата" fx:id="dateColumn" prefWidth="120"/>
                    <TableColumn text="Группа" fx:id="groupColumn" prefWidth="150"/>
                    <TableColumn text="Часы" fx:id="hoursColumn" prefWidth="80"/>
                    <TableColumn text="Тип занятия" fx:id="typeColumn" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </Tab>
</TabPane>